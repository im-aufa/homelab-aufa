# Copy this file to .env and fill in all values before deploying.

# --- Database ---
# Run db/setup.sql first to create the cerina user and database.
DATABASE_URL=postgresql://cerina:CHANGE_ME@postgres:5432/cerina

# --- Ollama ---
OLLAMA_BASE_URL=http://ollama:11434/v1
CHAT_MODEL=qwen3.5:4b
EMBEDDING_MODEL=qwen3-embedding:0.6b

# --- Local Auth ---
# Generate a strong secret: openssl rand -hex 32
LOCAL_SECRET_KEY=change-me-please-use-a-random-secret
LOCAL_USERNAME=admin
LOCAL_PASSWORD=changeme

# --- CORS ---
# Your Tailscale HTTPS URL, e.g. https://hostname.tail12345.ts.net
# Leave blank to block all cross-origin requests (safe default).
# ALLOWED_ORIGINS=https://your-tailscale-hostname.ts.net
